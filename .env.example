# Warehouse target: duckdb (default, local) or snowflake
TG_TARGET=duckdb
DUCKDB_PATH=data/warehouse.duckdb

# Snowflake (Phase 8, trial account)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=THERMALGUARD
SNOWFLAKE_SCHEMA=RAW

# MLflow (local by default; DagsHub later)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Training feature source: lakehouse (Delta gold table) or dbt (warehouse mart)
TG_FEATURE_SOURCE=lakehouse

# GenAI assistant (Phase 5 / T3). Free tier: https://console.groq.com/keys  (key starts with gsk_)
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b   (list yours: Groq console → Models)
# Alternative free provider: LLM_PROVIDER=gemini + GOOGLE_API_KEY=  (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Quieter MLflow logs
MLFLOW_DISABLE_AGENT_HINT=1

# RAGAS judge (separate free-tier quota from the assistant model)
RAGAS_JUDGE_MODEL=qwen/qwen3.8-27b
