# Warehouse target: duckdb (default, local) or snowflake
TG_TARGET=duckdb
DUCKDB_PATH=data/warehouse.duckdb

# Snowflake (only needed with TG_TARGET=snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=THERMALGUARD
SNOWFLAKE_SCHEMA=RAW

# MLflow (local SQLite by default; point at a remote server if you have one)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Training feature source: lakehouse (Delta gold table) or dbt (warehouse mart)
TG_FEATURE_SOURCE=lakehouse

# Maintenance assistant LLM. Groq: https://console.groq.com/keys  (key starts with gsk_)
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b   (see the Groq console for available models)
# Alternative provider: LLM_PROVIDER=gemini + GOOGLE_API_KEY=  (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Quieter MLflow logs
MLFLOW_DISABLE_AGENT_HINT=1

# RAGAS judge model (a different model from the assistant, so it does not grade itself)
RAGAS_JUDGE_MODEL=openai/gpt-oss-20b
